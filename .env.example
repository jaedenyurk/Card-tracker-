# Postgres connection string (Vercel Storage -> Postgres will inject this automatically as POSTGRES_PRISMA_URL / DATABASE_URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password to access the site (choose your own)
APP_PASSWORD="change-me"

# Random secret used to sign the login session cookie (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-string"

# Bank Feed (Plaid). Leave these out and the Bank Feed page just shows a setup panel.
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="the-secret-for-the-environment-below"
# sandbox = fake banks for testing, production = your real accounts
PLAID_ENV="sandbox"
# Encrypts the stored bank access tokens (generate with: openssl rand -base64 32)
PLAID_TOKEN_KEY="replace-with-32-random-bytes-base64"
# Optional: needed for banks that sign you in on their own site. Also add it under Allowed redirect URIs in Plaid.
# PLAID_REDIRECT_URI="https://your-site.vercel.app/bank"
