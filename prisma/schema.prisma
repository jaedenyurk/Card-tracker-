generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single sports card (or sealed item) that has been bought for the business.
// Money fields are stored in cents (Int) to avoid floating point rounding issues.
model Card {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Identity
  player      String
  sport       String
  year        String?
  setName     String?
  cardNumber  String?
  parallel    String? // e.g. "Prizm Silver", "Refractor"
  gradingCo   String? // e.g. "PSA", "BGS", "SGC", or null if raw/ungraded
  grade       String? // e.g. "10", "9.5"
  imageUrl    String?
  notes       String?

  // Acquisition
  purchaseDate  DateTime
  purchasePrice Int      // cents
  purchasePlatform String? // eBay, COMC, local show, etc.

  // Disposition
  status      CardStatus @default(HELD)
  soldDate    DateTime?
  soldPrice   Int?       // cents
  soldPlatform String?

  // Optional current estimated market value for held cards (for unrealized ROI)
  marketValue Int?

  expenses    Expense[]
  revenues    Revenue[]

  @@index([status])
  @@index([sport])
}

enum CardStatus {
  HELD
  SOLD
}

// A bulk purchase of multiple cards bought together for one total price (e.g. a
// large lot from an auction or box break). Individual cards inside a lot aren't
// tracked one by one — instead you log sales against the lot as pieces of it sell.
model Lot {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name         String
  source       String? // eBay, local show, etc.
  purchaseDate DateTime
  totalCards   Int
  totalCost    Int      // cents
  notes        String?

  // Estimated current value of this lot's not-yet-sold cards (for unrealized
  // P&L), same idea as Card.marketValue. Feeds the dashboard's Inventory
  // (Est. Value) / Unrealized P&L / Overall ROI once set.
  estValue     Int?

  sales       LotSale[]

  @@index([purchaseDate])
}

// A single sale transaction against a Lot: some number of cards sold together.
// salePrice is what the cards actually sold for; profit is computed and stored
// at write time as salePrice minus (quantity * the lot's cost-per-card) — never
// the raw sale price. salePrice is nullable only because sales logged before
// this field existed have just a stored profit and no recorded sale price.
model LotSale {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  saleDate  DateTime
  quantity  Int
  salePrice Int?     // cents; null for legacy sales logged before this field existed
  profit    Int      // cents; computed from salePrice minus this sale's share of lot cost

  notes     String?

  @@index([lotId])
}

// Business expenses. May optionally be tied to a specific card (e.g. grading fee,
// shipping cost for that sale) or be a general operating expense (subscriptions,
// supplies, booth fees, mileage, etc.)
model Expense {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  date        DateTime
  category    String   // Grading, Shipping, Supplies, Fees, Travel, Software, Other
  description String
  amount      Int      // cents

  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  bankTransactions BankTransaction[]

  @@index([date])
  @@index([category])
}

// Money actually taken in — the dashboard's Total Revenue and Net P&L are driven
// entirely from this table (and Expense), independent of a card's soldPrice.
// The optional card link is just a reference tag, it doesn't feed any inventory
// calculation (cost basis, realized profit, etc. still key off Card/Expense only).
model Revenue {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  date        DateTime
  category    String   // Card Sale, Lot Sale, Shipping, Other
  description String
  amount      Int      // cents

  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  bankTransactions BankTransaction[]

  @@index([date])
  @@index([category])
}

// ---- Bank feed (Plaid) ------------------------------------------------------
// Bank and credit card transactions pulled in through Plaid. They land in a
// review inbox first; adding one creates a normal Expense or Revenue row, so
// everything downstream (dashboard, period filters, P&L) works unchanged.

enum BankTxStatus {
  NEW      // waiting for review
  ADDED    // turned into an Expense / Revenue (or linked to an existing one)
  IGNORED  // not business (personal, or a transfer between own accounts)
}

// One connected login at a bank or card issuer.
model PlaidItem {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())

  plaidItemId     String    @unique
  institutionName String
  accessToken     String    // AES-256-GCM encrypted (see lib/plaidCrypto.ts), never the raw Plaid token
  cursor          String?   // Plaid transactions/sync cursor: where the last sync stopped
  lastSyncedAt    DateTime?
  syncError       String?

  accounts        BankAccount[]
}

model BankAccount {
  id             String    @id @default(cuid())
  plaidAccountId String    @unique

  itemId         String
  item           PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  name           String
  mask           String?   // last 4 digits, as Plaid reports them
  type           String    // depository, credit, ...
  tracked        Boolean   @default(true) // untracked accounts (e.g. personal) stay out of the review inbox

  transactions   BankTransaction[]

  @@index([itemId])
}

model BankTransaction {
  id                 String       @id @default(cuid())
  createdAt          DateTime     @default(now())

  plaidTransactionId String       @unique

  accountId          String
  account            BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date               DateTime
  name               String       // statement description
  merchantName       String?      // Plaid's cleaned-up merchant, when it has one
  amount             Int          // cents; positive = money in, negative = money out
  plaidCategory      String?      // Plaid's detailed category, e.g. FOOD_AND_DRINK_COFFEE

  status             BankTxStatus @default(NEW)
  category           String?      // the Expense/Revenue category it was filed under

  expenseId          String?
  expense            Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  revenueId          String?
  revenue            Revenue?     @relation(fields: [revenueId], references: [id], onDelete: SetNull)

  @@index([status, date])
  @@index([accountId])
}

// "Always file Starbucks as Travel": remembered from the review inbox and used
// to pre-fill the same merchant next time.
model BankRule {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  merchantKey String   // normalized merchant name, see lib/bankFeed.ts
  direction   String   // OUT (money spent) or IN (money received)
  action      String   // ADD or IGNORE
  category    String?  // Expense/Revenue category when action is ADD

  @@unique([merchantKey, direction])
}
