generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single sports card (or sealed item) that has been bought for the business.
// Money fields are stored in cents (Int) to avoid floating point rounding issues.
model Card {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Identity
  player      String
  sport       String
  year        String?
  setName     String?
  cardNumber  String?
  parallel    String? // e.g. "Prizm Silver", "Refractor"
  gradingCo   String? // e.g. "PSA", "BGS", "SGC", or null if raw/ungraded
  grade       String? // e.g. "10", "9.5"
  imageUrl    String?
  notes       String?

  // Acquisition
  purchaseDate  DateTime
  purchasePrice Int      // cents
  purchasePlatform String? // eBay, COMC, local show, etc.

  // Disposition
  status      CardStatus @default(HELD)
  soldDate    DateTime?
  soldPrice   Int?       // cents
  soldPlatform String?

  // Optional current estimated market value for held cards (for unrealized ROI)
  marketValue Int?

  expenses    Expense[]
  revenues    Revenue[]

  @@index([status])
  @@index([sport])
}

enum CardStatus {
  HELD
  SOLD
}

// A bulk purchase of multiple cards bought together for one total price (e.g. a
// large lot from an auction or box break). Individual cards inside a lot aren't
// tracked one by one — instead you log sales against the lot as pieces of it sell.
model Lot {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name         String
  source       String? // eBay, local show, etc.
  purchaseDate DateTime
  totalCards   Int
  totalCost    Int      // cents
  notes        String?

  // Estimated current value of this lot's not-yet-sold cards (for unrealized
  // P&L), same idea as Card.marketValue. Feeds the dashboard's Inventory
  // (Est. Value) / Unrealized P&L / Overall ROI once set.
  estValue     Int?

  sales       LotSale[]

  @@index([purchaseDate])
}

// A single sale transaction against a Lot: some number of cards sold together.
// salePrice is what the cards actually sold for; profit is computed and stored
// at write time as salePrice minus (quantity * the lot's cost-per-card) — never
// the raw sale price. salePrice is nullable only because sales logged before
// this field existed have just a stored profit and no recorded sale price.
model LotSale {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  saleDate  DateTime
  quantity  Int
  salePrice Int?     // cents; null for legacy sales logged before this field existed
  profit    Int      // cents; computed from salePrice minus this sale's share of lot cost

  notes     String?

  @@index([lotId])
}

// Business expenses. May optionally be tied to a specific card (e.g. grading fee,
// shipping cost for that sale) or be a general operating expense (subscriptions,
// supplies, booth fees, mileage, etc.)
model Expense {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  date        DateTime
  category    String   // Grading, Shipping, Supplies, Fees, Travel, Software, Other
  description String
  amount      Int      // cents

  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

// Money actually taken in — the dashboard's Total Revenue and Net P&L are driven
// entirely from this table (and Expense), independent of a card's soldPrice.
// The optional card link is just a reference tag, it doesn't feed any inventory
// calculation (cost basis, realized profit, etc. still key off Card/Expense only).
model Revenue {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  date        DateTime
  category    String   // Card Sale, Lot Sale, Shipping, Other
  description String
  amount      Int      // cents

  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}
